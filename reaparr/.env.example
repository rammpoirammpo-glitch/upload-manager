# Copy this file to `.env` (same directory as docker-compose.yml) and edit.
# These values are picked up automatically by docker-compose.

# The port Reaparr's web UI will be reachable on, on the HOST machine.
# (Inside the container the app always listens on 7000.)
HOST_PORT=7000

# User/group IDs that the container runs as. MUST match the owner of the
# ./Config ./Downloads ./Movies ./TvShows folders you created on the host.
# Run `id` in a terminal to see your values (usually 1000:1000).
PUID=1000
PGID=1000

# Your Unix timezone (e.g. Europe/Berlin, America/New_York, Asia/Riyadh).
TZ=UTC

# Optional logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO